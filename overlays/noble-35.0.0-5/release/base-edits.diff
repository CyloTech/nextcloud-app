--- base/scripts/nginx_php7.sh
+++ image/scripts/nginx_php7.sh
@@ -24,7 +24,7 @@
 
 # Set php vars
 echo "Set php vars"
-cat << EOF >> /etc/php/8.3/fpm/conf.d/20-docker.ini
+cat << EOF >> /etc/php/8.4/fpm/conf.d/20-docker.ini
 cgi.fix_pathinfo=0
 upload_max_filesize = 20G
 post_max_size = 1G
@@ -48,7 +48,7 @@
 mkdir -p /etc/service/phpfpm
 cat << EOF >> /etc/service/phpfpm/run
 #!/bin/sh
